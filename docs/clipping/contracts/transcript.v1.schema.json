{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-clip.transcript.v1",
  "title": "ai-clip.transcript.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifact_id",
    "source",
    "source_time_unit",
    "interval_semantics",
    "pipeline_version",
    "pipeline_manifest_sha256",
    "original_script_preserved",
    "translation_applied",
    "generated_speech",
    "dialogue_reordered",
    "segments",
    "words",
    "evidence_events"
  ],
  "properties": {
    "version": {
      "const": "ai-clip.transcript.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "source.v1.schema.json"
    },
    "source_time_unit": {
      "const": "ms"
    },
    "interval_semantics": {
      "const": "half_open"
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the immutable run manifest recording provider/model/alignment/prompt versions and material parameters."
    },
    "original_script_preserved": {
      "const": true
    },
    "translation_applied": {
      "const": false
    },
    "generated_speech": {
      "const": false
    },
    "dialogue_reordered": {
      "const": false
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "start_ms",
          "end_ms",
          "text",
          "language_spans"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "language_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_char",
                "end_char",
                "language"
              ],
              "properties": {
                "start_char": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_char": {
                  "type": "integer",
                  "minimum": 1
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                }
              }
            }
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word_id",
          "segment_id",
          "text",
          "start_ms",
          "end_ms",
          "language",
          "alignment_state",
          "start_char",
          "end_char"
        ],
        "properties": {
          "word_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "end_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "alignment_state": {
            "enum": [
              "aligned",
              "unaligned"
            ]
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "evidence_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "start_ms",
          "end_ms",
          "kind",
          "description"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "speech",
              "silence",
              "non_speech_audio",
              "visual_event"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
