{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-clip.candidates.v1",
  "title": "ai-clip.candidates.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "source", "transcript_artifact_id", "source_time_unit", "interval_semantics", "ranking_policy_version", "deduplication_policy_version", "evidence_version", "pipeline_manifest_sha256", "generated_speech", "dialogue_reordered", "candidates", "suppressed_candidates"],
  "properties": {
    "version": { "const": "ai-clip.candidates.v1" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "source": { "$ref": "source.v1.schema.json" },
    "transcript_artifact_id": { "type": "string", "minLength": 1 },
    "source_time_unit": { "const": "ms" },
    "interval_semantics": { "const": "half_open" },
    "ranking_policy_version": { "type": "string", "minLength": 1 },
    "deduplication_policy_version": { "type": "string", "minLength": 1 },
    "evidence_version": { "const": "ai-clip.transcript.v1" },
    "pipeline_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the immutable run manifest recording provider/model/prompt versions and material parameters." },
    "generated_speech": { "const": false },
    "dialogue_reordered": { "const": false },
    "candidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "rank", "start_ms", "end_ms", "evidence_refs", "editorial_score"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "editorial_score": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scale", "components", "total"],
            "properties": {
              "scale": { "const": "editorial_ordinal_1_to_5_not_probability" },
              "total": { "type": "integer", "minimum": 5, "maximum": 25 },
              "components": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hook", "emotional_impact", "retention", "shareability", "standalone_context"],
                "properties": {
                  "hook": { "$ref": "#/$defs/component" },
                  "emotional_impact": { "$ref": "#/$defs/component" },
                  "retention": { "$ref": "#/$defs/component" },
                  "shareability": { "$ref": "#/$defs/component" },
                  "standalone_context": { "$ref": "#/$defs/component" }
                }
              }
            }
          }
        }
      }
    },
    "suppressed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "kept_candidate_id", "overlap_fraction_of_shorter"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "kept_candidate_id": { "type": "string", "minLength": 1 },
          "overlap_fraction_of_shorter": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale", "evidence_refs"],
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
